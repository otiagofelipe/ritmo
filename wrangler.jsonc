{
  // Mesmo nome do Worker que já existe: o deploy atualiza ele, e os
  // secrets DBX_HOST, DBX_TOKEN e WAREHOUSE_ID continuam onde estão.
  "name": "ritmo-caju",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",

  // A página: o que o `vite build` gera em dist/. Arquivo que existe
  // é servido direto; o resto (as rotas /api/...) cai no Worker.
  "assets": {
    "directory": "./dist"
  },

  // Onde fica a foto. O id está no painel, em Storage & Databases → KV,
  // ou no terminal com: npx wrangler kv namespace list
  "kv_namespaces": [
    { "binding": "RITMO_CACHE", "id": "e755d52c7cfb437d985d89b005c0944a" }
  ],

  // Agendamento da foto: desligado, como está hoje no painel. A foto
  // continua sendo atualizada a cada leitura completa da página. Para
  // ligar, descomente e ajuste o horário (sempre em UTC):
  // "triggers": { "crons": ["30 */4 * * *"] },

  // Login: o Cloudflare Access é ligado no painel (aba Access do
  // Worker). O Worker confere o token do Access com as chaves do seu
  // time. ACCESS_TEAM é o endereço da tela de login do Access;
  // ACCESS_AUD identifica a aplicação do Access deste Worker (é o "kid"
  // que aparece na URL da tela de login).
  "vars": {
    "ACCESS_TEAM": "https://throbbing-dream-b5d1.cloudflareaccess.com",
    "ACCESS_AUD": "d1d5767ab1f91f0484757afb05b82a2200c4dd73e06f3e4e4f86e7605c649465"
  },

  // Só vale no `wrangler dev`: finge um login para a API responder na
  // sua máquina.
  "access": {
    "dev": {
      "aud": "ritmo-dev",
      "identity": { "email": "tfrsantos99@gmail.com" }
    }
  },

  // Variáveis de texto criadas no painel não são apagadas pelo deploy.
  "keep_vars": true,

  "observability": { "enabled": true }
}
